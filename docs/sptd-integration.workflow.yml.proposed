# PROPOSED, not active: copy to .github/workflows/test-examples-sptd.yml only after the owner
# decides the runner label, the secrets and where the artifact set is fetched from
# (docs/sptd-integration.md, "Workflow"). NON_RELEASE dev path.
#
# Deploy only: it onboards nothing, signs nothing and holds no key. The node must already
# hold the artifact set (scripts/sptd/integration/provision_dev_node.py, a root step on the
# node under a typed line). Per demo: native run -> confidential Pod Ready -> demo check ->
# cleanup, one demo at a time (hostNetwork Pods share the node's ports).
name: Test Examples (sptd, deploy only)

on:
  workflow_dispatch:
    inputs:
      artifact_set_sha256:
        description: "Artifact-set hash (sha256:<64 hex>) from the devvm re-onboarding run"
        required: true
        type: string
      node:
        description: "Kubernetes node name the set was onboarded for"
        required: true
        type: string
      image_digest:
        description: "Node image digest (sha256:<64 hex>) the set was onboarded for"
        required: true
        type: string
      demos:
        description: "Comma-separated demo subset; empty = every demo in the set"
        required: false
        default: ""
        type: string

permissions:
  contents: read

concurrency:
  group: test-examples-sptd-${{ inputs.node }}
  cancel-in-progress: false

env:
  ARTIFACT_SET_SHA256: ${{ inputs.artifact_set_sha256 }}
  SPTD_NODE: ${{ inputs.node }}
  SPTD_IMAGE_DIGEST: ${{ inputs.image_digest }}
  SPTD_DEMOS: ${{ inputs.demos }}

jobs:
  prepare:
    name: Fetch and validate the artifact set
    runs-on: [self-hosted, RUNNER-LABEL-PLACEHOLDER]
    timeout-minutes: 20
    outputs:
      demos: ${{ steps.demos.outputs.list }}
    steps:
      - uses: actions/checkout@v4

      - name: Check the inputs
        run: |
          [[ "$ARTIFACT_SET_SHA256" =~ ^sha256:[0-9a-f]{64}$ ]] || { echo "bad artifact_set_sha256"; exit 1; }
          [[ "$SPTD_IMAGE_DIGEST" =~ ^sha256:[0-9a-f]{64}$ ]] || { echo "bad image_digest"; exit 1; }
          [[ "$SPTD_NODE" =~ ^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$ ]] || { echo "bad node"; exit 1; }
          [[ -z "$SPTD_DEMOS" || "$SPTD_DEMOS" =~ ^[a-z0-9,-]+$ ]] || { echo "bad demos"; exit 1; }

      - name: Fetch the artifact set (PLACEHOLDER source)
        env:
          ARTIFACT_SET_SOURCE: ${{ secrets.PLACEHOLDER_SPTD_ARTIFACT_SET_SOURCE }}
        run: |
          # Owner decision: where the devvm publishes the set (deploy view: manifest.json,
          # node-set/, steps/, bundles/*/{bundle,checksums}.json; no rootfs payload, no key).
          # Example shape only:
          #   oras pull "$ARTIFACT_SET_SOURCE@$ARTIFACT_SET_SHA256" -o "$RUNNER_TEMP/artifact-set"
          echo "artifact-set fetch is a placeholder" >&2
          exit 1

      - name: Validate the pinned set
        run: |
          python3 scripts/sptd/integration/artifact_manifest.py validate \
            "$RUNNER_TEMP/artifact-set/manifest.json" --expect-hash "$ARTIFACT_SET_SHA256"

      - name: Demo list
        id: demos
        run: |
          python3 - "$RUNNER_TEMP/artifact-set/manifest.json" "$SPTD_DEMOS" <<'PY' >> "$GITHUB_OUTPUT"
          import json, sys
          present = [d["demo"] for d in json.load(open(sys.argv[1]))["demos"]]
          wanted = [d for d in sys.argv[2].split(",") if d]
          missing = sorted(set(wanted) - set(present))
          if missing:
              sys.exit("demos not in the set: " + ", ".join(missing))
          print("list=" + json.dumps([d for d in present if not wanted or d in wanted]))
          PY

      - uses: actions/upload-artifact@v4
        with:
          name: sptd-artifact-set
          path: ${{ runner.temp }}/artifact-set
          retention-days: 3

  demo:
    name: sptd ${{ matrix.demo }}
    needs: prepare
    runs-on: [self-hosted, RUNNER-LABEL-PLACEHOLDER]
    timeout-minutes: 60
    strategy:
      fail-fast: false
      max-parallel: 1
      matrix:
        demo: ${{ fromJSON(needs.prepare.outputs.demos) }}
    steps:
      - uses: actions/checkout@v4

      - uses: actions/download-artifact@v4
        with:
          name: sptd-artifact-set
          path: ${{ runner.temp }}/artifact-set

      - name: Kubeconfig (namespaced, PLACEHOLDER secret)
        env:
          KUBECONFIG_B64: ${{ secrets.PLACEHOLDER_SPTD_KUBECONFIG_B64 }}
        run: |
          umask 077
          printf '%s' "$KUBECONFIG_B64" | base64 -d > "$RUNNER_TEMP/kubeconfig"
          echo "KUBECONFIG=$RUNNER_TEMP/kubeconfig" >> "$GITHUB_ENV"

      - name: Native run, confidential Pod Ready, demo check, cleanup
        run: |
          python3 scripts/sptd/integration/deploy_demo.py \
            --set "$RUNNER_TEMP/artifact-set" --expect-hash "$ARTIFACT_SET_SHA256" \
            --node "$SPTD_NODE" --image-digest "$SPTD_IMAGE_DIGEST" \
            --demos "${{ matrix.demo }}" --report "$RUNNER_TEMP/report-${{ matrix.demo }}.json"

      - name: Report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: sptd-report-${{ matrix.demo }}
          path: ${{ runner.temp }}/report-${{ matrix.demo }}.json
          if-no-files-found: ignore

      - name: Remove the kubeconfig
        if: always()
        run: rm -f "$RUNNER_TEMP/kubeconfig"
